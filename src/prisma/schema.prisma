generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_DE_CREDITO
  CARTAO_DEBITO
}

enum SaleStatus {
  PAGO
  PENDENTE
}

model Loja {
  id        String  @id @default(cuid())
  name      String  @unique
  ownerName String
  phone     String?
  email     String? @unique
  document  String?
  logo      String?
  active    Boolean @default(true)

  address Address[]

  users        User[]
  accessGroups AccessGroup[]
  clients      Client[]
  categories   Category[]
  products     Product[]
  sales        Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id           String  @id @default(cuid())
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
  @@index([userId])
  @@index([clientId])
  @@index([city])
  @@index([state])
}

model AccessGroup {
  id          String  @id @default(cuid())
  name        String
  description String?
  active      Boolean @default(true)
  permissions Json

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaId, name])
  @@index([lojaId])
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  avatar    String?
  active    Boolean   @default(true)
  lastLogin DateTime?

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  groupId String
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  address Address[]
  sales   Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([lojaId])
  @@index([groupId])
  @@index([lojaId, name])
}

model Client {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  notes String?

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  address Address[]

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
  @@index([name])
  @@index([lojaId, name])
}

model Category {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaId, name])
  @@index([lojaId])
}

model Product {
  id   String  @id @default(cuid())
  code String?
  name String

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  description String?
  image       String?
  costPrice   Decimal @db.Decimal(10, 2)
  salePrice   Decimal @db.Decimal(10, 2)
  stock       Int
  minStock    Int
  notes       String?

  sales SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lojaId, code])
  @@index([lojaId])
  @@index([name])
  @@index([lojaId, name])
  @@index([categoryId])
  @@index([lojaId, categoryId])
}

model Sale {
  id            String        @id @default(cuid())
  date          DateTime      @default(now())
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(PENDENTE)
  dueDate       DateTime?
  notes         String?

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  clientName String?

  sellerId String?
  seller   User?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
  @@index([date])
  @@index([status])
  @@index([clientId])
  @@index([sellerId])
  @@index([lojaId, date])
  @@index([lojaId, status])
}

model SaleItem {
  saleId      String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([saleId, productId])
  @@index([productId])
}
